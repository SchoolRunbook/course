        "content": "## Branch 2: a reference responds\nWhen a new row lands in Reference Responses, count that candidate's responses. At 3, email Rosa.",
        "height": 260,
        "width": 1200,
        "color": 5
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Branch 2 note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, 220]
    },
    {
      "parameters": {
        "pollTimes": {
