        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "New candidate references",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// One form response has three references. Turn it into three items, one per reference.\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  for (const n of [1, 2, 3]) {\n    out.push({\n      json: {\n        candidateName: row['Your name'],\n        candidateEmail: row['Your email'],\n        referenceNumber: n,\n        referenceName: row[`Reference ${n} name`],\n        referenceEmail: row[`Reference ${n} email`],\n      },\n    });\n  }\n}\nreturn out;"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Split references",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.referenceEmail }}",
        "subject": "=Reference request for {{ $json.candidateName }}",
        "emailType": "text",
        "message": "=Hi {{ $json.referenceName }},\n\n{{ $json.candidateName }} has listed you as a reference for a role at InspireAwesomeness Academy. Could you take about five minutes to fill in our reference form?\n\nPASTE YOUR REFERENCE CHECK FORM LINK HERE\n\nThank you,\nRosa\nHR Coordinator, InspireAwesomeness Academy",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Email each reference",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, 0]
    },
